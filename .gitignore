*.sql
*.sql.gz

# Thư viện phụ thuộc bên thứ 3
vendor/

# Tệp tạm thời, nhật ký và hệ điều hành
*.tmp
*.log
.DS_Store
Thumbs.db
desktop.ini

# Cấu hình IDE / Trình soạn thảo
.vscode/
.idea/
